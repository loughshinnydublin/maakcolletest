{
    "controller": [
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "poi"
            }
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "{PROJECT_DIR}/resource"
            ]
        },
        {
            "name": "B 服",
            "path": [
                "{PROJECT_DIR}/resource",
                "{PROJECT_DIR}/resource_bilibili"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "{PROJECT_DIR}/agent/main.py"
        ]
    },
    "task": [
        {
            "name": "远征参数测试",
            "entry": "test_expedition",
            "option": [],
            "advanced": [
                "远征（自定义）"
            ],
        },
        {
            "name": "带Custom的任务",
            "entry": "Default"
        },
        {
            "name": "5-2",
            "entry": "start"
        }
    ],
    "option": {},
    "advanced": {
        "持续时长": {
            "field": [
                "持续时间/分钟"
            ],
            "type": [
                "int"
            ],
            "default": [
                "0"
            ],
            "pipeline_override": {
                "AllIn": {
                    "action": {
                        "param": {
                            "custom_action_param": {
                                "target_count": "{持续时间/分钟}"
                            }
                        }
                    }
                }
            },
            "doc": "持续时间，0表示无限制"
        },
        "远征（自定义）": {
            "field": [
                "2队",
                "3队",
                "4队"
            ],
            "type": [
                "string",
                "string",
                "string"
            ],
            "default": [
                "0",
                "0",
                "0"
            ],
            "doc": "填写远征编号，0则不远征",
            "pipeline_override": {
                "AutoExpedition": {
                    "action": {
                        "param": {
                            "custom_action_param": {
                                "exp1": "{2队}",
                                "exp2": "{3队}",
                                "exp3": "{4队}"
                            }
                        }
                    }
                }
            }
        }
    }
}